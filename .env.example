# Optional: use an absolute or relative path for the local SQLite database.
EQUITY_RADAR_DB_PATH=personal_equity_radar.db

# Financial Modeling Prep fundamentals API key. Get one from the FMP dashboard.
FMP_API_KEY=

# Currency used for total portfolio valuation and P&L normalization.
PORTFOLIO_BASE_CURRENCY=USD

# Optional model-readiness email alert. Keep real values only in local .env.
MODEL_ALERT_EMAIL_TO=
MODEL_ALERT_APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
